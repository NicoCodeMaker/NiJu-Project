<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.niju_project">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Permiso para acceder a la galería de fotos -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NiJu_Project"
        tools:targetApi="31">

        <!-- Splash -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="@string/title_activity_login" />

        <!-- Home -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan"
            android:label="Inicio" />

        <!-- Contextos -->
        <activity
            android:name=".ContextsActivity"
            android:exported="true"
            android:label="Contextos" />

        <!-- Ruta -->
        <activity
            android:name=".RutaActivity"
            android:exported="true"
            android:label="Tu Ruta" />

        <!-- Lecciones -->
        <activity
            android:name=".LessonActivity"
            android:exported="true"
            android:label="Lecciones" />

        <!-- Prácticas -->
        <activity
            android:name=".PracticeActivity"
            android:exported="true"
            android:label="Práctica" />

        <!-- Perfil -->
        <activity
            android:name=".ProfileActivity"
            android:exported="true"
            android:label="Perfil" />

        <!-- Favoritos -->
        <activity
            android:name=".FavoritesActivity"
            android:exported="true"
            android:label="Favoritos" />

        <!-- Registro -->
        <activity android:name=".RegisterActivity" />

        <!-- Autenticación por teléfono -->
        <activity android:name=".PhoneAuthActivity" />

        <!-- 2FA TOTP -->
        <activity android:name=".TwoFactorActivity" />

        <!-- ── NUEVAS ACTIVITIES ────────────────────────────────────────── -->

        <!-- Configuración general -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Configuración"
            android:parentActivityName=".ProfileActivity" />

        <!-- Editar perfil -->
        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:label="Editar perfil"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".SettingsActivity" />

    </application>

</manifest>