<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Título de sección en pantallas de contenido -->
    <style name="NijuSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- ── Tipografía ───────────────────────────────────────────────────── -->
    <style name="TextAppearance.NiJu.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>
    <style name="TextAppearance.NiJu.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>
    <style name="TextAppearance.NiJu.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>
    <style name="TextAppearance.NiJu.Subtitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>
    <style name="TextAppearance.NiJu.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>
    <style name="TextAppearance.NiJu.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_text_hint</item>
    </style>
    <style name="TextAppearance.NiJu.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/color_accent</item>
    </style>
    <style name="TextAppearance.NiJu.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ── Botones (Material 3, esquinas de píldora) ────────────────────── -->
    <style name="Widget.NiJu.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">@style/TextAppearance.NiJu.Button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>
    <style name="Widget.NiJu.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAppearance">@style/TextAppearance.NiJu.Button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.NiJu.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAppearance">@style/TextAppearance.NiJu.Button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/color_option_stroke</item>
        <item name="android:textColor">@color/color_primary</item>
    </style>
    <style name="Widget.NiJu.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.NiJu.Button</item>
        <item name="android:textSize">15sp</item>
    </style>
    <!-- Opción de respuesta: tarjeta con borde, texto grande, alto mínimo táctil. -->
    <style name="Widget.NiJu.Button.Option" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">60dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.NiJu.Subtitle</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="strokeColor">@color/color_option_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/color_surface</item>
    </style>
    <!-- Botón sobre el gradiente de marca (blanco con texto de color). -->
    <style name="Widget.NiJu.Button.OnHero" parent="Widget.NiJu.Button">
        <item name="backgroundTint">@color/color_on_hero</item>
        <item name="android:textColor">@color/color_hero_end</item>
    </style>

    <!-- ── Tarjetas ─────────────────────────────────────────────────────── -->
    <style name="Widget.NiJu.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
    </style>
    <style name="Widget.NiJu.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">@color/color_border</item>
    </style>
    <style name="Widget.NiJu.Card.Soft" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/color_soft_blue</item>
        <item name="cardCornerRadius">20dp</item>
    </style>

    <!-- Tarjeta con escena de contexto: sin borde, sombra suave, esquinas amplias. -->
    <style name="Widget.NiJu.Card.Scene" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">3dp</item>
    </style>

    <!-- ── Campos de texto ──────────────────────────────────────────────── -->
    <style name="Widget.NiJu.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/color_primary</item>
        <item name="hintTextColor">@color/color_primary</item>
        <item name="startIconTint">@color/color_text_secondary</item>
    </style>

    <!-- ── Barras de progreso ───────────────────────────────────────────── -->
    <style name="Widget.NiJu.Progress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">10dp</item>
        <item name="trackCornerRadius">5dp</item>
        <item name="indicatorColor">@color/color_accent</item>
        <item name="trackColor">@color/color_accent_container</item>
        <item name="trackStopIndicatorSize">0dp</item>
    </style>
    <style name="Widget.NiJu.Progress.OnHero" parent="Widget.NiJu.Progress">
        <item name="indicatorColor">@color/color_on_hero</item>
        <item name="trackColor">@color/color_hero_chip</item>
    </style>
    <style name="Widget.NiJu.Progress.Success" parent="Widget.NiJu.Progress">
        <item name="indicatorColor">@color/color_success</item>
        <item name="trackColor">@color/color_success_container</item>
    </style>
    <style name="Widget.NiJu.Progress.Xp" parent="Widget.NiJu.Progress">
        <item name="indicatorColor">@color/color_xp</item>
        <item name="trackColor">@color/color_xp_container</item>
    </style>

    <!-- ── Chips ────────────────────────────────────────────────────────── -->
    <style name="Widget.NiJu.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAppearance">@style/TextAppearance.NiJu.Subtitle</item>
        <item name="android:textSize">14sp</item>
        <item name="chipMinHeight">40dp</item>
    </style>
    <!-- Palabra para ordenar: chip grande y táctil -->
    <style name="Widget.NiJu.Chip.Word" parent="Widget.Material3.Chip.Assist">
        <item name="android:textAppearance">@style/TextAppearance.NiJu.Subtitle</item>
        <item name="android:textSize">17sp</item>
        <item name="chipMinHeight">48dp</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="chipStrokeWidth">2dp</item>
        <item name="chipStrokeColor">@color/color_option_stroke</item>
        <item name="chipBackgroundColor">@color/color_surface</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>
</resources>
