<?xml version="1.0" encoding="utf-8"?>
<!-- Barra inferior: 5 destinos principales. BottomNavUtils marca el actual. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_navigation"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_alignParentBottom="true"
    android:background="@drawable/bg_bottom_nav"
    android:elevation="12dp"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_nav_item"
            android:importantForAccessibility="no"
            android:paddingVertical="4dp"
            android:src="@drawable/ic_home_active"
            app:tint="@color/nav_unselected" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/roboto_medium"
            android:maxLines="1"
            android:text="@string/nav_home"
            android:textColor="@color/nav_unselected"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navContexts"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_nav_item"
            android:importantForAccessibility="no"
            android:paddingVertical="4dp"
            android:src="@drawable/ic_book"
            app:tint="@color/nav_unselected" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/roboto_medium"
            android:maxLines="1"
            android:text="@string/nav_learn"
            android:textColor="@color/nav_unselected"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navReview"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_nav_item"
            android:importantForAccessibility="no"
            android:paddingVertical="4dp"
            android:src="@drawable/ic_review"
            app:tint="@color/nav_unselected" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/roboto_medium"
            android:maxLines="1"
            android:text="@string/nav_review"
            android:textColor="@color/nav_unselected"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navRewards"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_nav_item"
            android:importantForAccessibility="no"
            android:paddingVertical="4dp"
            android:src="@drawable/ic_trofeo"
            app:tint="@color/nav_unselected" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/roboto_medium"
            android:maxLines="1"
            android:text="@string/nav_rewards"
            android:textColor="@color/nav_unselected"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_nav_item"
            android:importantForAccessibility="no"
            android:paddingVertical="4dp"
            android:src="@drawable/ic_profile"
            app:tint="@color/nav_unselected" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/roboto_medium"
            android:maxLines="1"
            android:text="@string/nav_profile"
            android:textColor="@color/nav_unselected"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
