<?xml version="1.0" encoding="utf-8"?>
<!-- Paso de la ruta: número y línea · contexto · avance · evaluación -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStepNumber"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_circle_accent_soft"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="1" />

        <View
            android:id="@+id/stepLine"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/color_accent_container" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStep"
        style="@style/Widget.NiJu.Card.Scene"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <com.example.niju_project.ui.scene.ContextSceneView
                    android:id="@+id/sceneStep"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStepName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.NiJu.Subtitle"
                    tools:text="Hogar" />

                <TextView
                    android:id="@+id/tvStepMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.NiJu.Caption"
                    tools:text="2/2 lecciones · 5/12 dominadas" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:max="100"
                    app:trackThickness="6dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivStepBadge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_school"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
