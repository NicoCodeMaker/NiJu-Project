<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    tools:context=".PracticeActivity">

    <!-- ════════════════════════════════════
         LOADING OVERLAY
    ════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_screen_bg_purple"
        android:visibility="gone"
        android:elevation="20dp">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/color_accent" />
    </FrameLayout>

    <!-- ════════════════════════════════════
         PANEL DE RESPUESTA CORRECTA (overlay)
         Aparece encima de todo cuando acierta
    ════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/correctPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:elevation="30dp"
        android:clickable="true"
        android:focusable="true">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_marginHorizontal="24dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="24dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="@color/color_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <!-- Emoji grande de éxito -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_texto_5"
                    android:importantForAccessibility="no"
                    android:textSize="56sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_correcto"
                    android:textColor="@color/color_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvCorrectWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_word"
                    android:textColor="@color/color_accent"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvCorrectXp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_10_xp"
                    android:textColor="@color/color_success"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_xp_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnListenAnswerCorrect"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:minHeight="48dp"
                    android:text="@string/audio_listen"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_volume_up"
                    app:iconTint="@color/color_primary" />

                <!-- Botones: Continuar / Finalizar -->
                <Button
                    android:id="@+id/btnContinuePractice"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/color_accent"
                    android:text="@string/ui_continuar"
                    android:textColor="@color/color_on_solid"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnFinishPractice"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/color_background"
                    android:text="@string/ui_finalizar_sesion"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- ════════════════════════════════════
         PANEL DE RESPUESTA INCORRECTA (overlay)
    ════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/wrongPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:elevation="30dp"
        android:clickable="true"
        android:focusable="true">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_marginHorizontal="24dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="24dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="@color/color_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_texto_6"
                    android:importantForAccessibility="no"
                    android:textSize="56sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_casi"
                    android:textColor="@color/color_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvYourAnswer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_la_respuesta_correcta_era"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvCorrectAnswer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_word"
                    android:textColor="@color/color_warning"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnListenAnswerWrong"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:minHeight="48dp"
                    android:text="@string/audio_listen"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_volume_up"
                    app:iconTint="@color/color_primary" />

                <Button
                    android:id="@+id/btnContinueAfterWrong"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="@color/color_accent"
                    android:text="@string/ui_seguir_intentando"
                    android:textColor="@color/color_on_solid"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- ════════════════════════════════════
         CONTENIDO PRINCIPAL
    ════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation_include"
        android:orientation="vertical">

        <!-- ── HEADER: barra de progreso de sesión ── -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/top_wave_shape"
            android:paddingBottom="18dp">

            <!-- Botón cerrar (X) -->
            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/rounded_button_bg"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/ui_cerrar" />

            <!-- Índice de pregunta -->
            <TextView
                android:id="@+id/tvQuestionIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="20dp"
                android:text="@string/ui_1_10"
                android:textColor="@color/color_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Barra de progreso de sesión -->
            <ProgressBar
                android:id="@+id/progressSession"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_below="@id/tvQuestionIndex"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:progress="10"
                android:progressTint="@color/color_accent"
                android:backgroundTint="@color/color_accent_container" />
        </RelativeLayout>

        <!-- ── SCROLL DEL CONTENIDO ── -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <!-- ── CARD PRINCIPAL: imagen + palabra japonesa ── -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/color_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Imagen de la palabra -->
                        <ImageView
                            android:id="@+id/ivWordImage"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:scaleType="centerCrop"
                            android:importantForAccessibility="no" />

                        <!-- Enunciado: instrucción, palabra/frase, botón «Escuchar» y pista -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvWordCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/txtQuestion"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/color_text_primary"
                                    android:textSize="26sp"
                                    android:textStyle="bold" />

                                <!-- Solo cuando el enunciado está en inglés (en_to_es) -->
                                <ImageButton
                                    android:id="@+id/btnListenQuestion"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:background="?android:attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/audio_listen"
                                    android:src="@drawable/ic_volume_up"
                                    android:visibility="gone"
                                    app:tint="@color/listen_tint" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvDifficulty"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="14sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ── OPCIONES DE RESPUESTA ── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/session_choose_answer"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp"
                    android:layout_gravity="center_horizontal" />

                <Button
                    android:id="@+id/btnOption1"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="10dp"
                    android:backgroundTint="@color/color_surface"
                    android:textColor="@color/color_text_primary"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:text="@string/ui_opcion_1"
                    android:elevation="2dp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnOption2"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="10dp"
                    android:backgroundTint="@color/color_surface"
                    android:textColor="@color/color_text_primary"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:text="@string/ui_opcion_2"
                    android:elevation="2dp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnOption3"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="16dp"
                    android:backgroundTint="@color/color_surface"
                    android:textColor="@color/color_text_primary"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:text="@string/ui_opcion_3"
                    android:elevation="2dp"
                    android:stateListAnimator="@null" />

                <!-- ── BOTÓN CONFIRMAR ── -->
                <Button
                    android:id="@+id/btnNext"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:backgroundTint="@color/color_disabled_bg"
                    android:text="@string/ui_confirmar"
                    android:textAllCaps="false"
                    android:textColor="@color/color_text_hint"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:enabled="false" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- BOTTOM NAV -->
    <include
        android:id="@+id/bottom_navigation_include"
        layout="@layout/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>