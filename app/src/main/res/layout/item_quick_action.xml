<?xml version="1.0" encoding="utf-8"?>
<!-- Acceso rápido de Inicio: emoji · título · detalle con datos reales -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.NiJu.Card.Scene"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="112dp"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivQuickIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_quick_icon"
            android:importantForAccessibility="no"
            android:padding="11dp"
            app:tint="@color/white"
            tools:src="@drawable/ic_review" />

        <TextView
            android:id="@+id/tvQuickTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.NiJu.Subtitle"
            tools:text="Repasar" />

        <TextView
            android:id="@+id/tvQuickSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.NiJu.Caption"
            tools:text="6 pendientes · 2 urgentes" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
