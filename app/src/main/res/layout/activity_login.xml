<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true"
    tools:context=".LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Forma decorativa superior -->
        <ImageView
            android:id="@+id/topShape"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:scaleType="fitXY"
            android:src="@drawable/top_shape"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ProgressBar central -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- HEADER: Logo + mascota -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/appName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_bold"
                    android:text="NiJu"
                    android:textColor="#5865F2"
                    android:textSize="96sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/appSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/subtitle"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="35sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/nino"
                android:layout_width="120dp"
                android:layout_height="176dp"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/nino" />
        </LinearLayout>

        <!-- TARJETA FORMULARIO -->
        <androidx.cardview.widget.CardView
            android:id="@+id/formContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/color_surface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- Título sección -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:fontFamily="@font/roboto_bold"
                    android:text="Iniciar sesión"
                    android:textColor="@color/color_text_primary"
                    android:textSize="22sp" />

                <!-- EMAIL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/prompt_email"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/edittext_rounded_background"
                    android:fontFamily="@font/roboto_regular"
                    android:hint="ejemplo@correo.com"
                    android:inputType="textEmailAddress"
                    android:padding="14dp"
                    android:textColorHint="@color/color_text_hint"
                    android:textSize="15sp" />

                <!-- CONTRASEÑA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/prompt_password"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="8dp">

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autofillHints="password"
                        android:background="@drawable/edittext_rounded_background"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="••••••••"
                        android:inputType="textPassword"
                        android:paddingStart="14dp"
                        android:paddingEnd="48dp"
                        android:textColorHint="@color/color_text_hint"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/ivTogglePassword"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/show_password"
                        android:src="@drawable/ic_eye_closed" />
                </RelativeLayout>

                <!-- ¿Olvidaste tu contraseña? -->
                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginBottom="20dp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="@string/forgot_password"
                    android:textColor="#5865F2"
                    android:textSize="13sp" />

                <!-- BOTÓN INICIAR SESIÓN -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/button_rounded_background"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/btn_login"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

                <!-- BOTÓN REGISTRARSE -->
                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/button_outline_background"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Crear cuenta"
                    android:textAllCaps="false"
                    android:textColor="#5865F2"
                    android:textSize="16sp" />

                <!-- DIVISOR: "o continúa con" -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/color_border" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:fontFamily="@font/roboto_regular"
                        android:text="o continúa con"
                        android:textColor="@color/color_text_hint"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/color_border" />
                </LinearLayout>

                <!-- BOTONES SOCIALES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Google -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoogle"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/button_social_background"
                        android:text="Google"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:icon="@drawable/ic_google"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart"
                        app:iconTint="@null"/>

                    <!-- Teléfono -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPhone"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/button_social_background"
                        android:text="Teléfono"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:icon="@drawable/ic_phone"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart"
                        app:iconTint="@null"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/bottomShape"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/bottom_shape" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Forma decorativa inferior -->

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>