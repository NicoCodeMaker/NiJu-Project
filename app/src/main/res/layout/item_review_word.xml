<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.NiJu.Card.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvWordIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_primary_soft"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/color_on_primary_container"
            android:textSize="20sp"
            tools:text="🎒" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWordEnglish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.NiJu.Subtitle"
                android:textSize="16sp"
                tools:text="backpack" />

            <TextView
                android:id="@+id/tvWordSpanish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.NiJu.Body"
                tools:text="mochila" />

            <TextView
                android:id="@+id/tvWordDue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.NiJu.Caption"
                tools:text="Próximo repaso: en 6 días · facilidad 2,6" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWordBucket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_accent"
            android:fontFamily="@font/roboto_medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/color_text_primary"
            android:textSize="12sp"
            tools:text="En repaso" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
