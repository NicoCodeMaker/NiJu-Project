<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true"
    tools:context=".RegisterActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/topShape"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:scaleType="fitXY"
            android:src="@drawable/top_shape"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Título de página -->
        <LinearLayout
            android:id="@+id/pageHeader"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:layout_marginHorizontal="32dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="Crear cuenta"
                android:textColor="@android:color/white"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:text="Únete y empieza a aprender japonés"
                android:textColor="#D1D5DB"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- FORMULARIO -->
        <androidx.cardview.widget.CardView
            android:id="@+id/formContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/color_surface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pageHeader">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- NOMBRE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Nombre completo"
                    android:textColor="#374151"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:autofillHints="name"
                    android:background="@drawable/edittext_rounded_background"
                    android:fontFamily="@font/roboto_regular"
                    android:hint="Tu nombre"
                    android:inputType="textPersonName|textCapWords"
                    android:padding="14dp"
                    android:textColorHint="@color/color_text_hint"
                    android:textSize="15sp" />

                <!-- EMAIL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Correo electrónico"
                    android:textColor="#374151"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/edittext_rounded_background"
                    android:fontFamily="@font/roboto_regular"
                    android:hint="ejemplo@correo.com"
                    android:inputType="textEmailAddress"
                    android:padding="14dp"
                    android:textColorHint="@color/color_text_hint"
                    android:textSize="15sp" />

                <!-- CONTRASEÑA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Contraseña"
                    android:textColor="#374151"
                    android:textSize="14sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="6dp">

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autofillHints="newPassword"
                        android:background="@drawable/edittext_rounded_background"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="Mín. 8 caracteres"
                        android:inputType="textPassword"
                        android:paddingStart="14dp"
                        android:paddingEnd="48dp"
                        android:textColorHint="@color/color_text_hint"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/ivTogglePassword"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/show_password"
                        android:src="@drawable/ic_eye_closed" />
                </RelativeLayout>

                <!-- Pista de requisitos -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="• Mínimo 8 caracteres  • Al menos 1 número  • Al menos 1 mayúscula"
                    android:textColor="@color/color_text_hint"
                    android:textSize="11sp" />

                <!-- CONFIRMAR CONTRASEÑA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Confirmar contraseña"
                    android:textColor="#374151"
                    android:textSize="14sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="20dp">

                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autofillHints="newPassword"
                        android:background="@drawable/edittext_rounded_background"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="Repite tu contraseña"
                        android:inputType="textPassword"
                        android:paddingStart="14dp"
                        android:paddingEnd="48dp"
                        android:textColorHint="@color/color_text_hint"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/ivToggleConfirm"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/show_password"
                        android:src="@drawable/ic_eye_closed" />
                </RelativeLayout>

                <!-- CHECKBOX Términos -->
                <CheckBox
                    android:id="@+id/cbTerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="Acepto los Términos y Condiciones y la Política de Privacidad"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />

                <!-- BOTÓN REGISTRARSE -->
                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/button_rounded_background"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Crear cuenta"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

                <!-- Link a iniciar sesión -->
                <TextView
                    android:id="@+id/tvSignIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_regular"
                    android:gravity="center"
                    android:text="¿Ya tienes cuenta? Inicia sesión"
                    android:textColor="#5865F2"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>