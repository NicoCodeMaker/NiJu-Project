<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjetas de la lección: escena animada del contexto, palabra con audio y onda de sonido,
     significado que se descubre con un toque (recuerdo activo) y ejemplo con la palabra resaltada. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <ScrollView
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/navButtons"
        android:clipToPadding="false"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <com.example.niju_project.ui.scene.ContextSceneView
                    android:id="@+id/sceneHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_scene_scrim" />

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="48dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/roboto_bold"
                    android:maxLines="2"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    tools:text="Un día de sol" />
            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card"
                style="@style/Widget.NiJu.Card.Scene"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="-36dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCardIndex"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true"
                            android:textSize="12sp"
                            tools:text="Palabra 3 de 6" />

                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textColor="@color/color_text_hint"
                            android:textSize="12sp"
                            tools:text="· Nueva" />

                        <ImageButton
                            android:id="@+id/btnFavorite"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/favorite_add"
                            android:src="@drawable/ic_star" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvEnglish"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/roboto_bold"
                            android:letterSpacing="-0.02"
                            android:textColor="@color/color_text_primary"
                            android:textSize="36sp"
                            tools:text="sunscreen" />

                        <!-- Imagen de la palabra (emoji) en un recuadro suave del color del contexto -->
                        <TextView
                            android:id="@+id/tvCardEmoji"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_marginStart="10dp"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textSize="32sp"
                            android:visibility="gone"
                            tools:text="🧴"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPronunciation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="16sp"
                            tools:text="/ˈsʌnskriːn/" />

                        <TextView
                            android:id="@+id/tvPartOfSpeech"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:textColor="@color/color_text_hint"
                            android:textSize="14sp"
                            android:textStyle="italic"
                            tools:text="sustantivo" />
                    </LinearLayout>

                    <!-- Escuchar la palabra + onda que se mueve mientras suena -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnListenWord"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_quick_icon"
                            android:contentDescription="@string/audio_listen"
                            android:padding="14dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_volume_up"
                            app:tint="@color/white" />

                        <com.example.niju_project.ui.widget.SoundWaveView
                            android:id="@+id/waveWord"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <!-- Significado: primero se intenta recordar; se descubre con un toque -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReveal"
                            style="@style/Widget.NiJu.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cards_reveal"
                            app:icon="@drawable/ic_lightbulb"
                            app:iconGravity="textStart" />

                        <LinearLayout
                            android:id="@+id/meaningBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="14dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cards_meaning"
                                android:textColor="@color/color_text_hint"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvSpanish"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_bold"
                                android:textSize="24sp"
                                tools:text="bloqueador solar" />
                        </LinearLayout>
                    </FrameLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="18dp"
                        android:background="@color/color_track" />

                    <TextView
                        android:id="@+id/tvExampleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cards_example"
                        android:textColor="@color/color_text_hint"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/rowExample"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvExampleEn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/color_text_primary"
                            android:textSize="18sp"
                            tools:text="Put on sunscreen before you swim." />

                        <ImageButton
                            android:id="@+id/btnListenExample"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/audio_listen_sentence"
                            android:src="@drawable/ic_volume_up"
                            app:tint="@color/listen_tint" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvExampleEs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="15sp"
                        tools:text="Ponte bloqueador antes de nadar." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Barra superior sobre la escena: volver + avance de la lección -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_white"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/color_on_pill" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressCards"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:max="100"
            app:indicatorColor="@color/white"
            app:trackColor="#59FFFFFF"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <include
        layout="@layout/view_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar" />

    <LinearLayout
        android:id="@+id/navButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/color_background"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrevious"
            style="@style/Widget.NiJu.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="@string/cards_previous" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextCard"
            style="@style/Widget.NiJu.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/cards_next" />
    </LinearLayout>
</RelativeLayout>
