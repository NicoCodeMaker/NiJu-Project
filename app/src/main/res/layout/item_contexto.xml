<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de contexto: escena animada propia del contexto, nombre, avance y estado. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.NiJu.Card.Scene"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="104dp">

            <com.example.niju_project.ui.scene.ContextSceneView
                android:id="@+id/scene_contexto"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tv_contexto_hecho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_pill_white"
                android:drawablePadding="4dp"
                android:fontFamily="@font/roboto_bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="@string/context_completed"
                android:textColor="@color/color_on_pill"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tv_contexto_nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/roboto_bold"
                android:maxLines="1"
                android:textSize="16sp"
                tools:text="Playa" />

            <TextView
                android:id="@+id/tv_contexto_lecciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.NiJu.Caption"
                tools:text="1 de 2 lecciones" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pb_contexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:importantForAccessibility="no"
                android:max="100"
                app:trackColor="@color/color_track"
                app:trackCornerRadius="3dp"
                app:trackThickness="6dp" />

            <TextView
                android:id="@+id/tv_contexto_examen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/roboto_bold"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Evaluación disponible"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
