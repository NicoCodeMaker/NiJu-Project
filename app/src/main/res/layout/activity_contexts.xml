<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ContextsActivity">

    <!-- 🔹 CONTENIDO PRINCIPAL CON SCROLL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/include_bottom_navigation"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Logo superior -->
            <ImageView
                android:id="@+id/logoNiJu"
                android:layout_width="109dp"
                android:layout_height="119dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/logo_niju"
                android:contentDescription="@string/app_name" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Elige un contexto"
                android:textColor="#1A1A1A"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <!-- 🔹 LISTA DE CONTEXTOS (RECYCLER VIEW) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvContexts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:padding="8dp" />

            <!-- 🔹 BOTÓN PRINCIPAL -->
            <Button
                android:id="@+id/btnStartSession"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#007BFF"
                android:text="Comenzar sesión de hoy"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <!-- 🔹 BARRA DE NAVEGACIÓN INFERIOR REUTILIZABLE -->
    <include
        android:id="@+id/include_bottom_navigation"
        layout="@layout/bottom_navigation"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
