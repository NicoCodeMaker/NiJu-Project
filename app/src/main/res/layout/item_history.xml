<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvHistIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_accent_soft"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textSize="18sp"
        tools:text="📘" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHistTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.NiJu.Subtitle"
            tools:text="Lección · En el salón" />

        <TextView
            android:id="@+id/tvHistMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.NiJu.Caption"
            tools:text="8 nov · 5/6 correctas · 2 min" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHistScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_success"
        android:fontFamily="@font/roboto_bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/color_success"
        android:textSize="13sp"
        tools:text="83 %" />
</LinearLayout>
