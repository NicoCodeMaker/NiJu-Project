<?xml version="1.0" encoding="utf-8"?>
<!-- Insignia (logro): medalla, nombre y avance. Bloqueada = atenuada con candado. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.NiJu.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:minHeight="132dp"
        android:orientation="vertical"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <TextView
                android:id="@+id/tvBadgeIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_xp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textSize="28sp"
                tools:text="🏆" />

            <TextView
                android:id="@+id/tvBadgeLock"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_badge_neutral"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="🔒"
                android:textSize="11sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvBadgeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.NiJu.Subtitle"
            android:textSize="13sp"
            tools:text="Primer paso" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no"
            android:max="100"
            app:trackThickness="6dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
