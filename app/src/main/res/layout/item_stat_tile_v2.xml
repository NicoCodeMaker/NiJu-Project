<?xml version="1.0" encoding="utf-8"?>
<!-- Mosaico de estadística: emoji · valor grande · descripción -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.NiJu.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="92dp"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvTileEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textSize="18sp"
            tools:text="📘" />

        <TextView
            android:id="@+id/tvTileValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/roboto_bold"
            android:textColor="@color/color_text_primary"
            android:textSize="22sp"
            tools:text="5 / 24" />

        <TextView
            android:id="@+id/tvTileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.NiJu.Caption"
            tools:text="Lecciones superadas" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
