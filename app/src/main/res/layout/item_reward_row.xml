<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de recompensa: emoji en círculo · título y detalle · insignia de XP -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvRowIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_circle_accent_soft"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textSize="22sp"
        tools:text="🏆" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.NiJu.Subtitle"
            tools:text="Primer paso" />

        <TextView
            android:id="@+id/tvRowSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.NiJu.Caption"
            tools:text="Completa tu primera lección." />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRowBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_badge_xp"
        android:fontFamily="@font/roboto_bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/color_xp"
        android:textSize="13sp"
        tools:text="+20 XP" />
</LinearLayout>
