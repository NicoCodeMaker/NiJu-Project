<?xml version="1.0" encoding="utf-8"?>
<!-- Resultado de una sesión: puntuación, XP, logros, retos y siguiente paso. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".ui.results.SessionResultActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="40dp"
                    android:paddingBottom="32dp">

                    <TextView
                        android:id="@+id/tvResultEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:textSize="48sp"
                        tools:text="🎉" />

                    <TextView
                        android:id="@+id/tvResultTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:accessibilityHeading="true"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="center"
                        android:textColor="@color/color_on_hero"
                        android:textSize="26sp"
                        tools:text="¡Lección superada!" />

                    <TextView
                        android:id="@+id/tvResultSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="@color/color_on_hero_soft"
                        android:textSize="15sp"
                        tools:text="Lección · En el salón" />

                    <com.example.niju_project.ui.widget.ScoreRingView
                        android:id="@+id/scoreRing"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_marginTop="20dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStatXp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_hero"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:textColor="@color/color_on_hero"
                            android:textSize="14sp"
                            tools:text="⚡ +80 XP" />

                        <TextView
                            android:id="@+id/tvStatTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_hero"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:textColor="@color/color_on_hero"
                            android:textSize="14sp"
                            tools:text="⏱ 1 min" />

                        <TextView
                            android:id="@+id/tvStatStreak"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_hero"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:textColor="@color/color_on_hero"
                            android:textSize="14sp"
                            tools:text="🔥 3 días" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Mensaje principal (superada, falta poco, evaluación…) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMessage"
                    style="@style/Widget.NiJu.Card.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/tvResultMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="18dp"
                        android:textColor="@color/color_text_primary"
                        android:textSize="15sp"
                        tools:text="Respondiste 5 de 6. La siguiente lección ya está abierta." />
                </com.google.android.material.card.MaterialCardView>

                <!-- Recompensas obtenidas -->
                <TextView
                    android:id="@+id/tvRewardsTitle"
                    style="@style/NijuSectionTitle"
                    android:layout_marginHorizontal="20dp"
                    android:text="@string/result_rewards_title" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRewards"
                    style="@style/Widget.NiJu.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:id="@+id/rewardsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_surface"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResultPrimary"
                style="@style/Widget.NiJu.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/common_continue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResultSecondary"
                style="@style/Widget.NiJu.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                tools:text="Repetir lección"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <com.example.niju_project.ui.widget.ConfettiView
        android:id="@+id/confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
